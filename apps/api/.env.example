NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://autolayer:autolayer@localhost:5434/autolayer
# Generate with: openssl rand -base64 32
KEY_ENCRYPTION_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
KEY_ENCRYPTION_VERSION=1
# Production example:
# CORS_ORIGINS=https://autolayer.fi,https://www.autolayer.fi,https://console.autolayer.fi
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5001
DISCOVERY_CONTACT_EMAIL=support@autolayer.fi
DISCOVERY_CONTACT_URL=https://www.autolayer.fi
STELLAR_RPC_KEY=
STELLAR_MAINNET_RPC_URL=https://mainnet.sorobanrpc.com
BASE_FEE=1000000
AUTOMATION_AUTH_TTL_LEDGERS=120
X402_MAX_TRANSACTION_FEE_STROOPS=50000

# Treasury receives exact automation payments.
TREASURY_G_ACCOUNT=G...
X402_NETWORK=TESTNET
X402_BASE_PRICE=500000
# Optional canonical-client evidence settings. When set, the native
# /examples/protocol-spec resource charges this SEP-41 asset and recipient.
X402_TESTNET_EVIDENCE_ASSET=
X402_TESTNET_EVIDENCE_PAY_TO=
X402_TESTNET_EVIDENCE_AMOUNT=10000
X402_QUOTE_TTL_SECONDS=900
PAYMENT_AUTH_TTL_LEDGERS=300
PAYMENT_CONFIRMATION_TIMEOUT_MS=120000

# Keep these as different funded G-accounts.
AUTOMATION_PAYMASTER_SECRET=S...
PAYMENT_RELAYER_SECRET=S...
# Optional comma-separated signer/channel account pool. Falls back to PAYMENT_RELAYER_SECRET.
PAYMENT_RELAYER_SECRETS=
X402_MAINNET_API_KEYS=
X402_FACILITATOR_REQUESTS_PER_MINUTE=600
X402_MAINNET_PLATFORM_FEE_BPS=0
EXECUTION_MODE=mock

AGENDA_PROCESS_EVERY=5 seconds
AGENDA_MAX_CONCURRENCY=10
JOB_LOCK_LIFETIME_MS=120000
HTTP_TIMEOUT_MS=30000
# Administrative/self-hosted access only. Console users issue personal keys after wallet authentication.
# Generate a long random value; do not expose it in the web application.
XWRAPPER_API_KEYS=dev-autolayer-change-me
XWRAPPER_MAX_REDIRECTS=0
